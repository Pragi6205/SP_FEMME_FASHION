# Copy to .env.local and fill in. Values marked NEXT_PUBLIC_ are baked in at build time.

# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp business number in international format, digits only (e.g. 919876543210).
# When empty, "Chat on WhatsApp" buttons fall back to the Contact page.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional contact details shown in the footer and Contact page (hidden when empty)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Where consultation and contact enquiries are delivered (server-only).
# Any endpoint that accepts multipart form posts: Formspree, Getform, Basin, a Make/Zapier/n8n webhook…
# Without this, the forms show an honest "not sent" message with a WhatsApp fallback.
ENQUIRY_FORWARD_URL=
# Optional bearer token sent as "Authorization: Bearer <token>"
ENQUIRY_FORWARD_TOKEN=
